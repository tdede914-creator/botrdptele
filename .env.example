# ===================================================================
# KOBONG CLOUD SERVER — contoh konfigurasi environment
# Salin file ini menjadi .env lalu isi dengan nilai asli Anda.
# JANGAN pernah commit file .env yang berisi kredensial asli!
# ===================================================================

# ---------- Telegram Bot ----------
TELEGRAM_BOT_TOKEN=123456789:GANTI_DENGAN_TOKEN_BOT_ANDA
ADMIN_ID=123456789
ADMIN_USERNAME=@username_admin
ADMIN_CONTACT=@kontak_admin

# ---------- Channel Notifikasi ----------
NOTIFY_CHANNEL_ID=-1000000000000
TESTIMONI_CHANNEL_ID=-1000000000

# ---------- Aset Menu (opsional) ----------
TESTIMONI_IMAGE_PATH=assets/testimoni.jpg
MENU_IMAGE_PATH=assets/menu.jpg

# ---------- Payment Gateway (QRIS / E-Wallet) ----------
ATLANTIS_API_KEY=GANTI_DENGAN_API_KEY_ANDA
ATLANTIS_API_ENDPOINT=https://atlantich2h.com
# API key gateway QRIS (dipakai bot & website untuk deposit)
DOMPETX_API_KEY=GANTI_DENGAN_API_KEY_GATEWAY

# Pilih gateway aktif: dompetx | pakasir | orderkuota | valqenix
PAYMENT_GATEWAY=dompetx

# ---------- Valqenix (https://app.valqenix.com) ----------
# Aktifkan dengan PAYMENT_GATEWAY=valqenix. Default di bawah sudah sesuai dokumentasi resmi.
VALQENIX_API_KEY=GANTI_DENGAN_API_KEY_VALQENIX
VALQENIX_BASE_URL=https://app.valqenix.com/api/v1
VALQENIX_CREATE_PATH=/payments
VALQENIX_STATUS_PATH=/payments/{id}
VALQENIX_CANCEL_PATH=/payments/{id}/cancel
VALQENIX_AUTH_HEADER=X-API-Key
VALQENIX_AUTH_PREFIX=
# Webhook secret (whsec_...) dari dashboard Valqenix — untuk verifikasi tanda tangan
# event webhook. Set Webhook URL di dashboard ke: https://DOMAIN-ANDA/webhooks/valqenix
VALQENIX_WEBHOOK_SECRET=

# ---------- Crypto Payment (Binance Personal API) ----------
BINANCE_API_KEY=
BINANCE_API_SECRET=
# BINANCE_BASE_URL=https://api.binance.com

# ---------- Fitur opsional ----------
# ENABLE_AUTO_BACKUP=1

# ===================================================================
# WEBSITE (KOBONG CLOUD SERVER Web App)
# ===================================================================
# Port HTTP untuk server web
WEB_PORT=3000
# Rahasia untuk menandatangani session/cookie website (buat string acak panjang)
WEB_SESSION_SECRET=ganti_dengan_string_acak_panjang
# URL publik website (dipakai untuk Telegram Login Widget)
WEB_PUBLIC_URL=http://localhost:3000
# Username bot (tanpa @) — WAJIB untuk tombol "Login with Telegram"
TELEGRAM_BOT_USERNAME=NamaBotAnda_bot
